# Servicio de órdenes (puerto 8000). Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real al repositorio.

# Conexión a PostgreSQL (por ejemplo, la cadena de conexión de tu proyecto de Supabase)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_base

# Debe ser la MISMA que en el servicio de auth (aquí solo se validan los tokens)
SECRET_KEY=cambia-esto-por-la-misma-clave-que-auth
ALGORITHM=HS256

# Clave interna compartida con el servicio de catálogo (header X-Service-Key).
# Debe ser la MISMA que SERVICE_KEY en catálogo.
SERVICE_KEY=cambia-esto-por-una-clave-interna-larga

# URL del servicio de catálogo (para descontar stock al crear una orden)
CATALOGO_URL=http://127.0.0.1:8001

# Probabilidad (0 a 1) de que el pago simulado sea exitoso
PAGO_PROBABILIDAD_EXITO=0.9
