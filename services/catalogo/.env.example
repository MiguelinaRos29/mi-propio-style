# Servicio de catálogo (puerto 8001). Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real al repositorio.

# Conexión a PostgreSQL (por ejemplo, la cadena de conexión de tu proyecto de Supabase)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_base

# Debe ser la MISMA que en el servicio de auth (aquí solo se validan los tokens)
SECRET_KEY=cambia-esto-por-la-misma-clave-que-auth
ALGORITHM=HS256

# Clave interna compartida con el servicio de órdenes (header X-Service-Key).
# Debe ser la MISMA que SERVICE_KEY en órdenes. Genera una con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_KEY=cambia-esto-por-una-clave-interna-larga
ORDENES_SERVICE_URL=http://127.0.0.1:8000

# Notificaciones por email de bajada de precio (Resend, https://resend.com)
RESEND_API_KEY=
EMAIL_NOTIFICACIONES_DESDE=onboarding@resend.dev
# En desarrollo, todos los avisos se envían a esta dirección en lugar de a los usuarios
EMAIL_NOTIFICACIONES_PRUEBA=tu-correo@ejemplo.com
