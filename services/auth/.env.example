# Servicio de autenticación (puerto 8002). Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real al repositorio.

# Conexión a PostgreSQL (por ejemplo, la cadena de conexión de tu proyecto de Supabase)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_base

# Clave para firmar los JWT. Debe ser la MISMA en auth, catálogo y órdenes.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Opcionales (valores por defecto del código)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
